{
  "cases": [
    {
      "assertions": {
        "/id": "2425e88933b3a065ba3b5787d86fba26ad450a9d",
        "/name": "conformance"
      },
      "capture": {
        "wallet_id": "/id"
      },
      "expected_status": 201,
      "id": "key-api-create",
      "ignore": {
        "/passphrase/last_updated_at": "creation time belongs to each service",
        "/state/progress/quantity": "restoration progress is an asynchronous observation; terminal readiness is asserted separately",
        "/tip/absolute_slot_number": "services can observe different tips",
        "/tip/epoch_number": "services can observe different tips",
        "/tip/height/quantity": "services can observe different tips",
        "/tip/slot_number": "services can observe different tips",
        "/tip/time": "services can observe different tips"
      },
      "operation": "postWallet",
      "request": {
        "body": {
          "address_pool_gap": 20,
          "mnemonic_sentence": [
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "abandon",
            "address"
          ],
          "name": "conformance",
          "passphrase": "${passphrase}"
        },
        "method": "POST",
        "path": "/wallets"
      },
      "settle_wallet_state": true
    },
    {
      "id": "network-guard-addresses-before",
      "operation": "listAddresses",
      "request": {
        "method": "GET",
        "path": "/wallets/${wallet_id}/addresses"
      },
      "expected_status": 200,
      "capture": {"network_guard_addresses": ""}
    },
    {
      "id": "address-cross-network-api-rejected",
      "operation": "constructTransaction",
      "requirements": ["address.network"],
      "source": "Pinned Haskell address network parser; same MAIN/TEST payment credential as src/live/precedence.rs, differing only in network tag",
      "request": {
        "method": "POST",
        "path": "/wallets/${wallet_id}/transactions-construct",
        "body": {
          "payments": [{"address": "addr1vxz6hulv54gzf2suy2u5gkvmt6ysasfdlvvegy3fmf969yc3nuz8v", "amount": {"quantity": 2000000, "unit": "lovelace"}}]
        }
      },
      "expected_status": 400,
      "assertions": {
        "": {"code": "bad_request", "message": "Error in $.payments[0].address: parsing AddressAmount failed, (String 'addr1vxz6hulv54gzf2suy2u5gkvmt6ysasfdlvvegy3fmf969yc3nuz8v',TextDecodingError {getTextDecodingError = 'Invalid network discrimination on address. Expecting Testnet but got Mainnet.'})"}
      }
    },
    {
      "id": "network-guard-testnet-control",
      "operation": "constructTransaction",
      "request": {
        "method": "POST",
        "path": "/wallets/${wallet_id}/transactions-construct",
        "body": {
          "payments": [{"address": "addr_test1vzz6hulv54gzf2suy2u5gkvmt6ysasfdlvvegy3fmf969yc2mg7gf", "amount": {"quantity": 2000000, "unit": "lovelace"}}]
        }
      },
      "expected_status": 403,
      "assertions": {
        "": {"code": "no_utxos_available", "message": "Unable to create a transaction because the wallet has no unspent transaction outputs (UTxOs) available. A transaction must spend at least one UTxO in order to be accepted for inclusion on the Cardano blockchain."}
      }
    },
    {
      "id": "network-guard-addresses-preserved",
      "operation": "listAddresses",
      "request": {
        "method": "GET",
        "path": "/wallets/${wallet_id}/addresses"
      },
      "expected_status": 200,
      "assertions": {"": "${network_guard_addresses}"}
    },
