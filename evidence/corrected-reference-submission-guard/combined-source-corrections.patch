 spec :: Spec
 spec = do
+    describe "resubmission bookkeeping after concurrent state changes" $ do
+        it "preserves a transaction confirmed after the pending read" $ do
+            let confirmed =
+                    apply
+                        (rollForwardTxSubmissions 10 [(8, transactionId)])
+                        pending
+            apply (resubmitTx transactionId 11 confirmed) confirmed
+                `shouldBe` confirmed
+        it "still refreshes ordinary pending retry metadata" $ do
+            let after = apply (resubmitTx transactionId 11 pending) pending
+                beforeEntry = getInSubmissionTransaction transactionId pending
+                afterEntry = getInSubmissionTransaction transactionId after
+            fmap _txStatus afterEntry `shouldBe` fmap _txStatus beforeEntry
+            fmap (submissionMetaResubmitted . _txStatusMeta) afterEntry
+                `shouldBe` Just 11
+        it "preserves a transaction expired after the pending read" $ do
+            let expired = apply (rollForwardTxSubmissions 1000 []) pending
+            apply (resubmitTx transactionId 1001 expired) expired
+                `shouldBe` expired
     around (withDBInMemory ForeignKeysDisabled) $ do
         describe "submissions via API for a single wallet store" $ do
             it "respects store laws"
                 $ property . prop_SingleWalletStoreLawsOperations
+  where
+    transactionId = Hash $ BS.replicate 32 1
+    sealed = mockSealedTx $ BS.replicate 16 2
+    pending =
+        applyOperations
+            (AddSubmission 1000 (TxId transactionId, sealed) dummyMetadata)
+            emptyTxSubmissions
 
 deriving instance Random SlotNo
 
